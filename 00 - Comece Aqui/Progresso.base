filters:
  and:
    - not:
        - file.inFolder("00 - Comece Aqui")
formulas:
  status: if(concluido, "✅ Concluído", if(conteudo_pronto, "📘 Pronto para estudar", "📝 Gerar conteúdo"))
  aproveitamento: if(acertos, (acertos / questoes * 100).toFixed(0) + "%", "")
properties:
  file.name:
    displayName: Nota
  note.tema:
    displayName: Tema
  note.concluido:
    displayName: Concluído
  note.concluido_em:
    displayName: Concluído em
  note.proxima_revisao:
    displayName: Próxima revisão
  note.acertos:
    displayName: Acertos
  note.questoes:
    displayName: Questões
  formula.status:
    displayName: Situação
  formula.aproveitamento:
    displayName: Aproveitamento
views:
  - type: table
    name: Próximos a estudar
    filters:
      and:
        - tipo == "conceito"
        - concluido != true
    order:
      - file.name
      - tema
      - formula.status
      - concluido
    sort:
      - property: file.path
        direction: ASC
    limit: 5
  - type: table
    name: Revisar hoje
    filters:
      and:
        - tipo == "conceito"
        - proxima_revisao && proxima_revisao <= today()
    order:
      - file.name
      - tema
      - concluido_em
      - proxima_revisao
    sort:
      - property: proxima_revisao
        direction: ASC
  - type: table
    name: Trilha completa
    filters:
      and:
        - tipo == "conceito"
    order:
      - file.name
      - tema
      - formula.status
      - concluido
      - concluido_em
      - proxima_revisao
    sort:
      - property: file.path
        direction: ASC
    summaries:
      concluido: Checked
  - type: table
    name: Treinos
    filters:
      and:
        - tipo == "treino"
    order:
      - file.name
      - tema
      - acertos
      - questoes
      - formula.aproveitamento
      - concluido
    sort:
      - property: file.path
        direction: ASC
  - type: table
    name: Conteúdo a gerar
    filters:
      and:
        - tipo == "conceito"
        - conteudo_pronto != true
    order:
      - file.name
      - tema
    sort:
      - property: file.path
        direction: ASC
  - type: table
    name: Aritmética
    filters:
      and:
        - tipo == "conceito"
        - file.inFolder("01 - Aritmética")
    order:
      - file.name
      - formula.status
      - concluido
      - concluido_em
      - proxima_revisao
    sort:
      - property: file.path
        direction: ASC
    summaries:
      concluido: Checked
  - type: table
    name: Álgebra
    filters:
      and:
        - tipo == "conceito"
        - file.inFolder("02 - Álgebra")
    order:
